# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
ROUTER_IP=192.168.1.1
ROUTER_2_PORT=8080

# Optional (defaults shown)
CHECK_INTERVAL=10
PING_TIMEOUT=2
DEBOUNCE_COUNT=6
REPORT_HOUR=7
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
TELEGRAM_RETRIES=3
STATS_SAVE_INTERVAL=6

# Optional: push state to the Mango Home dashboard (unset = disabled).
# MANGO_WEBHOOK_TOKEN must match POWER_REPORT_TOKEN on the Mango Home side.
#MANGO_WEBHOOK_URL=https://mango-home.net/api/power-status/report
#MANGO_WEBHOOK_TOKEN=
#MANGO_WEBHOOK_TIMEOUT=5
